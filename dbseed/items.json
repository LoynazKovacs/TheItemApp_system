    "key": "system_gpu_workloads",
    "collection": "system_gpu_workloads",
    "title": "GPU Workloads",
    "titleSingular": "GPU Workload",
    "titlePlural": "GPU Workloads",
    "description": "One row per GPU-consuming component (a loaded model / framework reservation) discovered by probing the GPU services in the catalog — e.g. an Ollama model, ComfyUI's torch reservation, an OmniVoice model. Carries estimated VRAM, device, load status, and whether it can be soft-unloaded. The 'Unload' row button frees it via the owning service.",
    "ai": {
      "purpose": "Per-app VRAM attribution — which model/framework is holding GPU memory right now and whether it can be released in-process.",
      "howItWorks": "The collector probes each enabled `system_gpu_services` row via a per-kind adapter (ollama /api/ps, comfyui /system_stats, omnivoice /model/loaded, or the generic /app/resources contract) and upserts one workload row per reported component.",
      "manipulation": "Read-only telemetry. Use the Unload row button to soft-free a workload through its service. Note that CUDA context memory often only fully returns when the container is stopped (see Containers).",
      "outcomes": [],
      "warnings": [
        "VRAM figures are self-reported by each framework and can be approximate."
      ]
    },
    "icon": "lucide:cpu",
    "appId": {
      "$oid": "8b0000000000000000000001"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
