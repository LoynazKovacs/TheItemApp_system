[
  {
    "_id": {
      "$oid": "8b0000000000000000030002"
    },
    "key": "system_containers",
    "collection": "system_containers",
    "title": "Containers",
    "titleSingular": "Container",
    "titlePlural": "Containers",
    "description": "One row per Docker container on the host (running and stopped), with live CPU %, memory, writable-disk footprint, restart count, uptime, published ports, and compose stack/service. Synced from the Docker socket by the system-api collector. Row buttons stop / start / restart a container (admin-gated; core/self/mongo are protected).",
    "ai": {
      "purpose": "The full container inventory with per-container CPU/RAM/disk/state — the 'what is running and what is it costing me' view, GPU or not.",
      "howItWorks": "The collector calls `docker stats` + `inspect` over the mounted socket each cycle and upserts one row per container keyed by name; rows for vanished containers are deleted.",
      "manipulation": "Read-only telemetry. Use the Stop/Start/Restart row buttons to control a container — they POST to system-api which calls the Docker daemon.",
      "outcomes": [
        {
          "outcome": "Reclaim all VRAM from an idle GPU app",
          "how": "Stopping its container is the only guaranteed full reclaim — in-process model unloads leave the CUDA context resident."
        }
      ],
      "warnings": [
        "Stopping a container is disruptive; the collector refuses to stop core (backend/web/mongo) or itself."
      ]
    },
    "icon": "lucide:box",
    "appId": {
      "$oid": "8b0000000000000000000001"
    },
