  {
    "_id": {
      "$oid": "8b0000000000000000030004"
    },
    "key": "system_gpu_services",
    "collection": "system_gpu_services",
    "title": "GPU Services",
    "titleSingular": "GPU Service",
    "titlePlural": "GPU Services",
    "description": "Catalog of GPU services the collector probes for VRAM attribution. This is configuration (input), not telemetry: add a row to monitor a new GPU service — pick its adapter `kind` (ollama / comfyui / omnivoice / app-resources), its base `url` on the theitemapp network, and the backing container name — and the collector picks it up on the next cycle with no code change.",
    "ai": {
      "purpose": "The seeded, user-editable list of GPU services to monitor. Generalises attribution: new GPU app = new row.",
      "howItWorks": "The collector reads enabled rows each cycle and dispatches to the matching adapter by `kind`. `app-resources` is the first-party contract (`GET {url}/app/resources`); the others wrap third-party native endpoints.",
      "manipulation": "Edit freely. Set `enabled` false to stop probing a service. `url` is the in-network base (e.g. http://ollama:11434).",
      "outcomes": [
        {
          "outcome": "Monitor a new GPU app",
          "how": "Create a row with its kind + url + container name."
        }
      ],
      "warnings": []
    },
    "icon": "lucide:plug",
    "appId": {
      "$oid": "8b0000000000000000000001"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "kind",
        "url"
      ],
      "properties": {
        "key": {
          "type": "string",
          "title": "Key",
          "description": "Stable unique key.",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "title": "Name",
          "description": "Display name.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "title": "Adapter",
          "description": "Which adapter probes this service. `container` = no API to query; attribute a fixed estimate while its container runs (offload = stop container).",
          "enum": [
            "ollama",
            "comfyui",
            "omnivoice",
            "app-resources",
            "container"
          ]
        },
        "url": {
          "type": "string",
          "title": "Base URL",
          "description": "In-network base URL, e.g. http://ollama:11434. Unused for `container` kind."
        },
        "containerName": {
          "type": "string",
          "title": "Container",
          "description": "Backing container name (for context / control / `container`-kind attribution)."
        },
        "vramEstimateMB": {
          "type": "number",
          "title": "VRAM estimate (MB)",
          "description": "For `container` kind: measured/expected resident VRAM while the container runs. Marked as an estimate in the workload."
        },
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Probe this service?",
          "default": true
        },
        "order": {
          "type": "number",
          "title": "Order",
          "description": "Sort order."
        },
        "groupIds": {
          "type": "array",
          "title": "Groups",
          "description": "Row-security scope.",
          "items": {
            "type": "string",
            "x-ref": "groups"
          }
        }
      }
    },
