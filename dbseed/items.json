    "key": "system_gpu_samples",
    "collection": "system_gpu_samples",
    "title": "GPU Samples",
    "titleSingular": "GPU Sample",
    "titlePlural": "GPU Samples",
    "description": "Rolling time-series of GPU utilisation, VRAM, power and temperature, sampled every few seconds by the collector. Backs the over-time charts so short GPU bursts (e.g. STT transcriptions) are visible. Pruned to a fixed rolling window.",
    "ai": {
      "purpose": "Time-series telemetry for the GPU activity charts — lets you see when and how hard the GPU is working over time.",
      "howItWorks": "A fast collector loop appends one row per sample (default every 5s) and prunes to the retention window (default 180 samples).",
      "manipulation": "Read-only. Charts aggregate it by timestamp.",
      "outcomes": [],
      "warnings": [
        "High-churn collection: rows are continuously created and pruned."
      ]
    },
    "icon": "lucide:activity",
    "appId": {
      "$oid": "8b0000000000000000000001"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tsMs"
      ],
      "properties": {
        "ts": {
          "type": "string",
          "title": "Time",
          "description": "ISO timestamp of the sample.",
          "x-ui": {
            "readonly": true
          }
        },
        "tsMs": {
          "type": "number",
          "title": "Time (ms)",
