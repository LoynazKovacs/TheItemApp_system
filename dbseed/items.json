  {
    "_id": {
      "$oid": "8b0000000000000000030001"
    },
    "key": "system_host",
    "collection": "system_host",
    "title": "Host",
    "titleSingular": "Host",
    "titlePlural": "Host",
    "description": "Singleton snapshot of the machine's resource totals — GPU (name, driver, VRAM total/used/free, utilisation), the VRAM attributed to known GPU services, and the live container count. Refreshed every poll cycle by the system-api collector from nvidia-smi + the Docker socket.",
    "ai": {
      "purpose": "Top-level gauge of the host: how much VRAM is used vs free, how much of it the monitor could attribute to a known GPU service, and how many containers are running.",
      "howItWorks": "The system-api collector runs `nvidia-smi` for GPU totals and counts containers from the Docker socket, then upserts the single `kind: 'host'` row each cycle.",
      "manipulation": "Read-only telemetry. Do not edit; the collector overwrites it every cycle. The 'Free idle GPU VRAM' row button triggers a batch soft-unload across all unloadable workloads.",
      "outcomes": [],
      "warnings": [
        "Per-container VRAM attribution is unavailable under WSL2; `vramAttributedMB` is the sum of what GPU-service adapters self-report and may be less than `vramUsedMB`."
      ]
    },
    "icon": "lucide:server",
    "appId": {
      "$oid": "8b0000000000000000000001"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "title": "Kind",
          "description": "Discriminator; always `host` for the singleton row.",
          "x-ui": {
            "readonly": true
          }
        },
        "name": {
          "type": "string",
          "title": "Host",
          "description": "Host label.",
          "x-ui": {
            "readonly": true
          }
        },
        "gpuName": {
          "type": "string",
          "title": "GPU",
          "description": "GPU model name from nvidia-smi.",
          "x-ui": {
            "readonly": true
          }
        },
        "gpuDriver": {
          "type": "string",
          "title": "Driver",
          "description": "NVIDIA driver version.",
          "x-ui": {
            "readonly": true
          }
        },
        "gpuPresent": {
          "type": "boolean",
          "title": "GPU present",
          "description": "Whether nvidia-smi was reachable.",
          "x-ui": {
            "readonly": true
          }
        },
        "vramTotalMB": {
          "type": "number",
          "title": "VRAM total (MB)",
          "description": "Total GPU memory.",
          "x-ui": {
            "readonly": true
          }
        },
        "vramUsedMB": {
          "type": "number",
          "title": "VRAM used (MB)",
          "description": "GPU memory in use (authoritative, from nvidia-smi).",
          "x-ui": {
            "readonly": true
          }
        },
        "vramFreeMB": {
          "type": "number",
          "title": "VRAM free (MB)",
          "description": "GPU memory free.",
          "x-ui": {
            "readonly": true
          }
        },
        "vramAttributedMB": {
          "type": "number",
          "title": "VRAM attributed (MB)",
          "description": "Sum of VRAM reported by known GPU services. May be less than used (un-attributed allocations / WSL2 limits).",
          "x-ui": {
            "readonly": true
          }
        },
        "vramUnattributedMB": {
          "type": "number",
